pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
    skipDefaultCheckout(false)
  }
  parameters {
    string(name: 'GIT_REF', defaultValue: 'origin/main', description: 'Manual: branch/SHA. Webhook sets GIT_SHA / PR_NUMBER.')
    string(name: 'GH_PR_NUMBER', defaultValue: '', description: 'Manual PR number. Webhook sets PR_NUMBER.')
  }
  environment {
    AWS_DEFAULT_REGION = 'ap-southeast-2'
    GITHUB_REPO        = 'minhtri1612/go-micro-infra'
  }
  stages {
    stage('Checkout PR') {
      steps {
        script {
          env.PLAN_REF = (env.GIT_SHA ?: '').trim() ?: (env.GIT_REF ?: params.GIT_REF)
          env.PLAN_PR  = (env.PR_NUMBER ?: '').trim() ?: (params.GH_PR_NUMBER ?: '')
        }
        sh '''
          set -euo pipefail
          git fetch --no-tags origin +refs/heads/*:refs/remotes/origin/* +refs/pull/*/head:refs/remotes/origin/pr/*
          git checkout -f "${PLAN_REF}"
          git rev-parse HEAD > .plan-sha
        '''
        script { env.PLAN_SHA = readFile('.plan-sha').trim() }
        withCredentials([usernamePassword(credentialsId: 'github-go-micro-pat', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_PAT')]) {
          sh 'chmod +x jenkins/terraform/github.sh && jenkins/terraform/github.sh status "${PLAN_SHA}" pending "terraform plan running"'
        }
      }
    }
    stage('Detect terraform') {
      steps {
        script {
          def rc = sh(returnStatus: true, script: '''
            set -euo pipefail
            git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main
            git diff --name-only origin/main...HEAD | grep -qE "^terraform/"
          ''')
          env.TF_CHANGED = (rc == 0) ? '1' : '0'
          echo "TF_CHANGED=${env.TF_CHANGED}"
        }
      }
    }
    stage('fmt validate plan') {
      when { environment name: 'TF_CHANGED', value: '1' }
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'aws-terraform-plan', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
          string(credentialsId: 'tf-db-password', variable: 'TF_VAR_db_password'),
          string(credentialsId: 'tf-stripe-secret-key', variable: 'TF_VAR_stripe_secret_key')
        ]) {
          withEnv(["TF_VAR_admin_ingress_cidr=${env.TF_ADMIN_INGRESS_CIDR}"]) {
            sh 'chmod +x jenkins/terraform/run.sh && jenkins/terraform/run.sh plan'
          }
        }
      }
    }
    stage('Comment PR') {
      when {
        allOf {
          environment name: 'TF_CHANGED', value: '1'
          expression { return env.PLAN_PR?.trim() }
        }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-go-micro-pat', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_PAT')]) {
          sh 'jenkins/terraform/github.sh comment-plan "${PLAN_PR}"'
        }
      }
    }
  }
  post {
    success {
      script {
        def desc = (env.TF_CHANGED == '1') ? 'plan ok' : 'no terraform/** changes'
        withCredentials([usernamePassword(credentialsId: 'github-go-micro-pat', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_PAT')]) {
          sh "jenkins/terraform/github.sh status '${env.PLAN_SHA}' success '${desc}'"
        }
      }
    }
    failure {
      script {
        if (env.PLAN_SHA?.trim()) {
          withCredentials([usernamePassword(credentialsId: 'github-go-micro-pat', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_PAT')]) {
            sh "jenkins/terraform/github.sh status '${env.PLAN_SHA}' failure 'terraform plan failed'"
          }
        }
      }
    }
    always {
      archiveArtifacts artifacts: 'terraform/environments/management/plan-summary.txt,terraform/environments/management/plan.txt', allowEmptyArchive: true, fingerprint: true
    }
  }
}
